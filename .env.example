# Vercel / Prisma Postgres (Storage → Prisma Postgres, or vercel env pull)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Google Gemini (AI Studio) — use Flash-Lite for ~500 free RPD
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash-lite"

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Aphros

# Admin dashboard
ADMIN_PASSWORD=aphros-admin-change-me
ADMIN_SECRET=change-me-to-a-long-random-string
