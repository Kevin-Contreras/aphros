# Vercel / Prisma Postgres (with prefix APHROS_ from Marketplace integration)
# Direct URL → migrations; pooled URL → app runtime
APHROS_DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
APHROS_DATABASE_URL_POOLED="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Optional aliases also supported:
# DATABASE_URL=...
# APHROS_POSTGRES_URL=...

# Public site URL (used for product images inside Brevo emails)
NEXT_PUBLIC_SITE_URL="https://aphros.vercel.app"

# Vercel Blob (required on Vercel to upload product images from admin)
# Create in Vercel → Storage → Blob, then connect to the project
BLOB_READ_WRITE_TOKEN=

# Google Gemini (AI Studio) — use Flash-Lite for ~500 free RPD
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash-lite"

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Aphros

# Admin dashboard
ADMIN_PASSWORD=aphros-admin-change-me
ADMIN_SECRET=change-me-to-a-long-random-string
